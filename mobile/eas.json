{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        // TestFlight builds show a Details line on the error-boundary screen,
        // so a caught error can be read off the device. Drop this from an App
        // Store profile when there is one.
        "EXPO_PUBLIC_ERROR_DETAILS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        // App Store Connect app (Apple ID). Without it --auto-submit cannot run
        // unattended: EAS has no app to upload to and falls back to prompting.
        "ascAppId": "6824029737"
      }
    }
  }
}
