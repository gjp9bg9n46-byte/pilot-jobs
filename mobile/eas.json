{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        // App Store Connect app (Apple ID). Without it --auto-submit cannot run
        // unattended: EAS has no app to upload to and falls back to prompting.
        "ascAppId": "6824029737"
      }
    }
  }
}
